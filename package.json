{
  "name": "autotranslate",
  "version": "0.1.2",
  "private": true,
  "description": "Automatic page translation extension for Chrome and Firefox (Manifest V3).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:chrome": "node scripts/build.ts --target=chrome",
    "build:firefox": "node scripts/build.ts --target=firefox",
    "watch": "node scripts/build.ts --watch",
    "icons": "node scripts/make-icons.ts",
    "plamo:gguf": "node scripts/plamo-gguf.ts",
    "predemo": "tsc -p tsconfig.json",
    "demo": "node scripts/serve-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "lint": "node scripts/build.ts --check",
    "verify": "node scripts/verify-package.ts",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run verify",
    "onnx:vendor": "node scripts/onnx-vendor.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wllama/wllama": "^3.8.1",
    "typescript": "^5.9.3",
    "webextension-polyfill": "0.12.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
