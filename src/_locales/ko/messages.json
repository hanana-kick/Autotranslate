  "glossary_sourceApi": { "message": "공식 API (통합 토큰)" },
  "glossary_sourceHint": { "message": "공개 페이지는 Notion에서 \"웹에 공개\"한 DB의 뷰 URL을 그대로 씁니다. 기본값이 미리 채워져 있으니 DB를 공개해 두었다면 그대로 동기화하면 됩니다. 토큰도 서버도 필요 없고, 페이지를 갱신하면 다음 동기화에 반영됩니다." },
  "glossary_conceptUrl": { "message": "개념 DB 공개 뷰 URL" },
